# ============================================================
# Environment Variables – Đồ án 08 EV Charging
# Copy file này thành .env (local) hoặc nhập vào Render Dashboard
# Không bao giờ commit file chứa trị thật
# ============================================================

# Node-RED credential encryption secret (bắt buộc, giữ ổn định)
NODE_RED_CREDENTIAL_SECRET=

# Node-RED Editor admin
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH=

# CloudAMQP MQTT
CLOUDAMQP_USERNAME=
CLOUDAMQP_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
